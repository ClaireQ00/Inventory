#!/bin/bash
# ============================================================
# Inventory 防泄露守门 · pre-commit
# 作用: 提交前扫描暂存区, 命中敏感路径/大文件直接拒绝提交
# 安装: bash tools/install_hooks.sh  (hooks 本身不进版本库)
# 绕过: 紧急情况可 git commit --no-verify (会留终端记录, 慎用)
# ============================================================

BLOCKED_REGEX='^(data/|mysql-data/|nocodb-data/|\.env$|\.env\.|private/)'
MAX_SIZE=$((2 * 1024 * 1024))   # 单文件 2MB 上限 (模板/代码都远小于此)

fail=0

# 1) 路径黑名单 (暂存区)
while IFS= read -r f; do
    # 豁免: 模板文件必须能提交
    case "$f" in
        .env.example) continue ;;
    esac
    if echo "$f" | grep -qE "$BLOCKED_REGEX"; then
        echo "❌ 拦截: $f  (真实数据/私密配置不进仓库)"
        fail=1
    fi
    # Excel 只允许 sample/ 下的模板
    if echo "$f" | grep -qiE '\.xlsx$' && ! echo "$f" | grep -q '^sample/'; then
        echo "❌ 拦截: $f  (Excel 真实数据不进仓库, 模板请放 sample/)"
        fail=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACMR)

# 2) 大文件 (防误传数据库导出/附件包)
while IFS= read -r f; do
    [ -f "$f" ] || continue
    size=$(stat -f%z "$f" 2>/dev/null || stat -c%s "$f" 2>/dev/null)
    if [ -n "$size" ] && [ "$size" -gt "$MAX_SIZE" ]; then
        echo "❌ 拦截: $f 超过 2MB ($((size / 1024))KB), 大文件不进仓库"
        fail=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "$fail" -eq 1 ]; then
    echo ""
    echo "提交已取消。确属误判请先和负责人确认, 不要直接 --no-verify。"
    exit 1
fi
exit 0
