# ============================================================
# Inventory 数据库配置模板
# ------------------------------------------------------------
# 用法:
#   1. 把这个文件复制一份, 命名为 .env   (cp .env.example .env)
#   2. 改掉下面的密码 (务必改成你自己的强密码!)
#   3. docker compose up -d 会自动读取 .env
#
# ⚠️ .env 文件已被 .gitignore 排除, 不会上传到 GitHub, 密码安全。
# ⚠️ 如果部署到 NAS 对外提供访问, 密码强度直接决定数据安全, 请用 16 位以上随机字符串。
# ============================================================

# MySQL root 密码 (首次启动数据库时设置, 之后改不了, 牢记!)
# 建议: 16 位以上, 字母+数字+符号混合
# 示例: 请改成你自己的强密码, 例如: My_Strong_Root_Pwd_2026!
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# 业务用的数据库名 (项目 SQL 脚本里写死是 inventory_db, 不要改)
MYSQL_DATABASE=inventory_db

# 给团队成员用的普通账号 (权限比 root 小, 更安全。团队用这个登录 Adminer)
MYSQL_USER=inventory
MYSQL_PASSWORD=CHANGE_ME_USER_PASSWORD

# Adminer 网页查询界面的端口 (浏览器访问用)
# 本地默认 8080; 如果 NAS 上 8080 被占用, 改成别的 (如 18080)
ADMINER_PORT=8080

# NocoDB 低代码表单界面端口 (feature/nocodb-test 分支试验用)
# 本地默认 8081; 跟 Adminer 错开避免冲突
NOCODB_PORT=8081

# Streamlit 工作台端口 (阶段一快速原型)
# 本地默认 8501; 如需错开改成别的 (如 18501)
STREAMLIT_PORT=8501

# React 录入端端口 (阶段二主力界面, 同事浏览器访问这个)
# 默认 8082; NAS 上对局域网开放, 如需 80 端口改成 FRONTEND_PORT=80
FRONTEND_PORT=8082

# ────────────────────────────────────────────────────────────
# 以下仅供 NAS 部署时参考 (本地开发用不到)
# ────────────────────────────────────────────────────────────
# MySQL 数据库端口已在 compose 里固定绑到 127.0.0.1:3306 (只本机能连, 不对外)。
# 团队远程访问走的是 Adminer 网页端口 (上面的 ADMINER_PORT), 不需要直连数据库。
# 完整 NAS 部署步骤见 docs/NAS_DEPLOY.md。
