# ============================================================
# Docker 构建排除清单
# ------------------------------------------------------------
# 列在这里的文件/目录不会被 COPY 进镜像。
# 主要目的: (1) 镜像更小更快  (2) 防止真实业务数据/密钥打进镜像外泄
# ============================================================

# ---- 真实业务数据 (绝不能进镜像!) ----
data/
private/

# ---- 环境与密钥 ----
.env
.env.*
*.log

# ---- Git / CI 元数据 ----
.git/
.github/
.gitignore

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
venv/

# ---- macOS 噪声 ----
.DS_Store

# ---- 编辑器/工具配置 (与运行无关) ----
.claude/
.claude-driver-logs/

# ---- 文档 (镜像里不需要, 团队看仓库即可) ----
docs/
*.md
