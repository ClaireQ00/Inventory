#!/bin/bash
# ============================================================
# Inventory 防泄露守门 · pre-push
# 作用: 推送前扫描将被推送的整棵文件树, 只要敏感路径曾经进入
#       版本库(哪怕后来删了, 历史里还在)就拒绝推送
# 安装: bash tools/install_hooks.sh
# 绕过: 紧急情况可 git push --no-verify (慎用, 外泄不可逆)
# ============================================================

# 认主检查: 只在 inventory 仓库里生效 (全局模板会把它带到别的仓库, 不能误拦)
[ -f "$(git rev-parse --show-toplevel 2>/dev/null)/.inventory-guard" ] || exit 0

BLOCKED_REGEX='^(data/|mysql-data/|nocodb-data/|\.env$|\.env\.|private/)|\.xlsx$'

# pre-push 从 stdin 读: <local ref> <local sha> <remote ref> <remote sha>
ZERO=0000000000000000000000000000000000000000
need_check=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue  # 删分支
    fail=0
    while IFS= read -r f; do
        case "$f" in
            .env.example) continue ;;
        esac
        # sample/ 下的 Excel 模板豁免
        if echo "$f" | grep -qiE '\.xlsx$' && echo "$f" | grep -q '^sample/'; then
            continue
        fi
        if echo "$f" | grep -qE "$BLOCKED_REGEX"; then
            echo "❌ 拦截: 推送内容含敏感路径 $f"
            fail=1
        fi
    done < <(git ls-tree -r --name-only "$local_sha")
    if [ "$fail" -eq 1 ]; then
        echo ""
        echo "推送已取消。敏感文件已进入 git 历史, 请联系负责人做历史清洗,"
        echo "不要 --no-verify 强推。"
        exit 1
    fi
    # 质量门槛 (2026-08-15 加): 推送范围含 Python 改动 → 完整双回归 make check
    if [ "$remote_sha" = "$ZERO" ]; then
        base=$(git merge-base "$local_sha" HEAD 2>/dev/null || echo "$local_sha")
    else
        base="$remote_sha"
    fi
    if git diff --name-only "$base" "$local_sha" 2>/dev/null | grep -qE '\.py$'; then
        need_check=1
    fi
done

if [ "$need_check" -eq 1 ] && [ -f "$(git rev-parse --show-toplevel)/Makefile" ]; then
    echo "→ 推送含 Python 改动, 跑完整质量门槛 make check (lint + e2e + 16 步校验)..."
    if ! (cd "$(git rev-parse --show-toplevel)" && make check); then
        echo ""
        echo "❌ make check 未过 (双回归红): 修复或回滚后再推, 不要 --no-verify。"
        exit 1
    fi
fi
exit 0
